{
  "name": "dsh-session-delete",
  "version": "0.2.1",
  "description": "在 DeepSeek Harness 侧边栏会话「…」菜单中添加「删除会话」：弹出确认框后永久删除该会话的全部数据（不进回收站，不可恢复）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "delete"
  ]
}
